APP_NAME="Cosmetic Store API"
APP_VERSION=1.0.0

# Absolute path inside the container (four slashes after sqlite:).
DATABASE_URL=sqlite:////app/data/cosmetic_store.db

# REQUIRED. Startup refuses to boot if this is missing, shorter than 32
# characters, or left as a known placeholder. Generate a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated allowlist. "*" is rejected: the API is credentialed, so an
# open origin lets any website read authenticated responses.
CORS_ORIGINS=http://localhost:8080

# --- Schema migrations --------------------------------------------------
# SQLite is single-writer and unsuitable for real payments. Move to PostgreSQL
# before enabling a provider:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/cosmetic
# then run `alembic upgrade head` as a release step, not on app startup.

# --- Payments -----------------------------------------------------------
# Keep PAYMENT_PROVIDER=none until a gateway is onboarded and sandbox-tested.
# Baray settles in USD, KHQR in KHR; CURRENCY must match what the provider
# expects or every webhook lands in manual_review.
CURRENCY=USD
PAYMENT_WINDOW_MINUTES=15
PAYMENT_PROVIDER=none

# REQUIRED for real payments: the provider posts webhooks here over HTTPS, so
# this must be the deployed public origin. Without it, orders sit in
# pending_payment until they expire.
PUBLIC_BASE_URL=

BARAY_SECRET_KEY=
BARAY_IV=
BARAY_PUBLIC_KEY=
PAYWAY_API_KEY=
PAYWAY_API_SECRET=
BAKONG_ACCESS_TOKEN=
