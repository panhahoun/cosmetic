APP_NAME=Cosmetic Store API
APP_VERSION=1.0.0

# SQLite (local dev): sqlite:///./cosmetic_store.db
# For Render/Neon use the pooled Postgres URL (will be normalized to +psycopg)
DATABASE_URL=sqlite:///./cosmetic_store.db

SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30

# Explicit CORS allowlist; must NOT be "*".
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

CURRENCY=USD
PAYMENT_PROVIDER=none
PAYMENT_WINDOW_MINUTES=15
PUBLIC_BASE_URL=
