APP_NAME="Cosmetic Store API"
APP_VERSION=1.0.0

# For SQLite use four slashes for an absolute path inside the container:
#   sqlite:////app/data/cosmetic_store.db
DATABASE_URL=sqlite:///./cosmetic_store.db

# REQUIRED. Startup refuses to boot if this is missing, shorter than 32
# characters, or left as a known placeholder. Generate a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated allowlist. "*" is rejected: the API is credentialed, so an
# open origin lets any website read authenticated responses.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# --- Schema migrations --------------------------------------------------
# Run from the backend/ directory before starting the app:
#   alembic upgrade head
# Existing databases created by the old create_all() path need one step first:
#   alembic stamp 0001_baseline && alembic upgrade head
# Database URL is read from settings, so migrations and the app always agree.

# --- Payments -----------------------------------------------------------
# Currency all prices and payment amounts are expressed in (ISO 4217).
# KHQR settles in KHR; most card gateways settle in USD. Do not mix.
CURRENCY=USD

# How long an order may wait in pending_payment before its reserved stock is
# released. Must stay below the provider's QR lifetime (KHQR caps at 10 min).
PAYMENT_WINDOW_MINUTES=15

# Which gateway handles card checkout: none | baray | payway | bakong | fake
# "none" keeps checkout on cash on delivery and makes /api/payments/intents
# return 503 instead of pretending to take money. Selecting a real provider
# without its credentials fails at startup, not at the first checkout.
PAYMENT_PROVIDER=none

# Public HTTPS origin of this API. The provider posts webhooks here, so an
# http:// value in production means payments are never confirmed. Leave empty
# for local development, where a tunnel URL changes per session.
PUBLIC_BASE_URL=

# Baray (aggregator: ABA / ACLEDA / Sathapana / Wing). Required when
# PAYMENT_PROVIDER=baray. Only ever set real values in a real environment.
BARAY_SECRET_KEY=
BARAY_IV=
BARAY_PUBLIC_KEY=

# ABA PayWay. Required when PAYMENT_PROVIDER=payway.
PAYWAY_API_KEY=
PAYWAY_API_SECRET=

# Bakong / NBC KHQR. Required when PAYMENT_PROVIDER=bakong.
# The token expires after 90 days and must be renewed before then.
BAKONG_ACCESS_TOKEN=
